# Seenarr secrets - copy to .env (chmod 600)
# Login password hash, see README:  printf '%s' 'pw' | docker run --rm -i --network none seenarr:local node server/dist/cli.js hash-password
PASSWORD_HASH_B64=
SONARR_API_KEY=
PLEX_TOKEN=
# Optional, for the Plex webhook: openssl rand -hex 24
PLEX_WEBHOOK_SECRET=
